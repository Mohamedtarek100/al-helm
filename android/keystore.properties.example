# Android release signing — TEMPLATE ONLY.
#
# Copy this file to `android/keystore.properties` and fill in the REAL values.
# `android/keystore.properties` is git-ignored and must never be committed.
#
#   Copy-Item android/keystore.properties.example android/keystore.properties
#
# Paths may be absolute (`C:/Users/you/.al-helm-keystore/alhelm-release.jks`)
# or relative to the `android/` project directory.
#
# NEVER commit, paste into chat, or put in CI logs:
#   storePassword, keyPassword, or the .jks file itself.

storeFile=C:/Users/you/.al-helm-keystore/alhelm-release.jks
storePassword=REPLACE_WITH_REAL_PASSWORD
keyAlias=REPLACE_WITH_REAL_ALIAS
keyPassword=REPLACE_WITH_REAL_PASSWORD
