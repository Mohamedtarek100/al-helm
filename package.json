{
  "name": "el-7lm",
  "private": true,
  "version": "1.5.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "test:i18n": "node scripts/check-translations.mjs",
    "test": "vitest run",
    "check:types": "tsc -p tsconfig.app.json --noEmit",
    "check:edge": "tsc -p supabase/tsconfig.json --noEmit",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:secrets": "node scripts/qa/bundle-secret-scan.mjs",
    "check:upgrade": "node scripts/qa/verify-android-upgrade-gate.mjs",
    "gen:migrations": "node scripts/gen-migrations.mjs",
    "check": "npm run check:types && npm run check:edge && npm run test:i18n && npm run test && npm run lint && npm run build && npm run check:secrets",
    "preview": "vite preview",
    "build:android": "node scripts/build-android-assets.mjs",
    "build:web": "node scripts/build-web-assets.mjs",
    "android:sync": "node scripts/build-android-assets.mjs && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:debug": "npm run android:sync && android\\gradlew.bat -p android assembleDebug"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^9.1.2",
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/push-notifications": "^7.0.7",
    "@capgo/capacitor-updater": "^7.53.0",
    "@supabase/supabase-js": "^2.118.0",
    "framer-motion": "^14.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/deno": "^2.7.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.81.0",
    "supabase": "^2.122.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.12"
  }
}
